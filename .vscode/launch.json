{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Pomodoro 🦉",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/pomodoro",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build pomodoro"
        }
    ]
}
